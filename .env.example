# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA versione o arquivo ".env" preenchido (adicione-o ao .gitignore).

# --- Servidor ---
PORT=3000
NODE_ENV=production
# TRUST_PROXY: deixe em branco na maioria dos casos. Em producao (Render, Railway,
# Fly.io etc.) o padrao ja fica ligado automaticamente por causa do proxy de TLS.
# Defina TRUST_PROXY=0 apenas se tiver certeza de que NAO ha proxy reverso na frente.
# TRUST_PROXY=1

# --- Banco de dados (PostgreSQL / Supabase) ---
# String de conexao completa. Para Supabase, use a "Connection string" (modo "Session"
# ou "Transaction pooler") disponivel em Project Settings > Database.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# --- Sessao / Autenticacao ---
# Gere uma string aleatoria longa, por exemplo: openssl rand -hex 32
SESSION_SECRET=troque_por_uma_string_aleatoria_longa

ADMIN_USERNAME=admin
# Gere o hash bcrypt da senha desejada rodando localmente:
#   npm run hash-password "sua-senha-aqui"
# e cole o resultado abaixo (comeca com $2a$ ou $2b$).
ADMIN_PASSWORD_HASH=$2a$10$substitua_pelo_hash_gerado

# --- Google Sheets (Service Account) ---
# 1. No Google Cloud Console, crie um projeto e ative a "Google Sheets API".
# 2. Crie uma Service Account e gere uma chave JSON.
# 3. Cole o CONTEUDO INTEIRO do arquivo JSON aqui, em uma unica linha.
# 4. Compartilhe cada planilha que sera usada com o "client_email" dessa
#    service account (Editor, se for necessario escrever/exportar dados).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"nome@projeto.iam.gserviceaccount.com", ...}
