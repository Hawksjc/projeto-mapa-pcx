# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA versione o arquivo ".env" preenchido (adicione-o ao .gitignore).

# --- Servidor ---
PORT=3000
NODE_ENV=production
# TRUST_PROXY: deixe em branco na maioria dos casos. Em producao (Render, Railway,
# Fly.io etc.) o padrao ja fica ligado automaticamente por causa do proxy de TLS.
# Defina TRUST_PROXY=0 apenas se tiver certeza de que NAO ha proxy reverso na frente.
# TRUST_PROXY=1

# --- Banco de dados (PostgreSQL / Supabase) ---
# String de conexao completa. Para Supabase, use a "Connection string" (modo "Session"
# ou "Transaction pooler") disponivel em Project Settings > Database.
DATABASE_URL=postgresql://postgres.gjaacslgthcciwaghimk:@@DPH-SEDUH@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# --- Sessao / Autenticacao ---
# Gere uma string aleatoria longa, por exemplo: openssl rand -hex 32
SESSION_SECRET=768f16383bc1f2427bbcbcfdb365e0ac877a2d21aa577ac113ad0da2c8f9819a

ADMIN_USERNAME=DPH
# Gere o hash bcrypt da senha desejada rodando localmente:
#   npm run hash-password "sua-senha-aqui"
# e cole o resultado abaixo (comeca com $2a$ ou $2b$).
ADMIN_PASSWORD_HASH=$2a$10$bQ9J.4acTFYX31/xM9TFLeKZwtktW0x54xBUgH1nrfncM/K7OVPVm

